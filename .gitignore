# -----------------------------------------------------------------------------
# School Funding Model: Git ignore rules
# -----------------------------------------------------------------------------

# R and RStudio local state
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.Rapp.history

# Local environment files and secrets
.Renviron
.Renviron.*
!.Renviron.example
.env
.env.*
!.env.example
credentials/
secrets/
*.pem
*.key
*.p12
*.pfx

# Generated pipeline outputs
# Remove these rules only if generated run snapshots should be versioned.
data/output/*
!data/output/.gitkeep

# Local preparation and scratch folders
prep/
scratch/
temp/
tmp/
cache/
.cache/

# R package and dependency caches
renv/library/
renv/staging/
renv/python/
renv/local/
packrat/lib*/
packrat/src/
packrat/archives/

# R package build and check artifacts
.Rcheck/
*.Rcheck/
*.tar.gz
src/*.o
src/*.so
src/*.dll

# R Markdown and Quarto generated support files
*_cache/
*_files/
.quarto/
_site/
_book/

# Logs, temporary files, and backups
*.log
*.out
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
~$*

# Editor settings
.vscode/
.idea/

# macOS
.DS_Store
._*
__MACOSX/

# Windows
Thumbs.db
Desktop.ini

# Linux
*~
.nfs*
